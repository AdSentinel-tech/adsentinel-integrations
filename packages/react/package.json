{
  "name": "@adsentinel/react",
  "version": "0.1.0",
  "description": "Server-side React integration for AdSentinel: resolve a site's serving tags from the control API and inject them into the page <head>, idiomatically and fail-open, for Next.js (App Router + Pages Router), Remix and Vike.",
  "keywords": [
    "adsentinel",
    "adblock-recovery",
    "react",
    "nextjs",
    "remix"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdSentinel-tech/adsentinel-integrations.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/AdSentinel-tech/adsentinel-integrations/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/AdSentinel-tech/adsentinel-integrations/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@adsentinel/plugin-core": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
