{
  "name": "@adsentinel/nuxt",
  "version": "0.1.0",
  "description": "AdSentinel Nuxt 3 module: injects the two serving tags into the SSR <head>, server-side and fail-open, on top of @adsentinel/plugin-core.",
  "keywords": [
    "adsentinel",
    "adblock-recovery",
    "nuxt",
    "nuxt-module",
    "nitro"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdSentinel-tech/adsentinel-integrations.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://github.com/AdSentinel-tech/adsentinel-integrations/tree/main/packages/nuxt#readme",
  "bugs": {
    "url": "https://github.com/AdSentinel-tech/adsentinel-integrations/issues"
  },
  "type": "module",
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@adsentinel/plugin-core": "^0.1.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0",
    "h3": "^1.8.0",
    "nitropack": "^2.0.0",
    "nuxt": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "nitropack": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    }
  }
}
